# Example .env for serversage
# Copy this file to .env and fill in real values. Do NOT commit your real .env.

# Discord Bot Configuration
DISCORD_BOT_TOKEN=
DISCORD_BOT_TOKEN_FILE=

# LLM API Configuration
LLM_API_URL=http://localhost:3000/api/chat/completions
LLM_API_TOKEN=
LLM_API_TOKEN_FILE=
LLM_MODEL_NAME=gpt-5-mini-2025-08-07

# Discord Role IDs (replace with actual Role IDs from your server)
VERIFIED_ROLE_ID=
UNVERIFIED_ROLE_ID=
VERIFICATION_IN_PROGRESS_ROLE_ID=
ADMIN_ROLE_IDS=111111111111111111,222222222222222222

# Discord Channel IDs
NOTIFICATION_CHANNEL_ID=
WELCOME_CHANNEL_ID=

# Bot Behavior Configuration
VERIFICATION_RETRIES=3
REBUILD_ROLE_CATEGORIES_ON_STARTUP=false

# Suspicious account / moderation settings
SUSPICIOUS_ROLE_ID=
SUSPICIOUS_CHECK_INTERVAL_HOURS=24
SUSPICIOUS_ROLE_RETENTION_DAYS=7

# LLM tuning and prompt controls (optional)
WELCOME_TEMPERATURE=0.7
WELCOME_HARDCODE=false
WELCOME_HARDCODE_MESSAGE=
WELCOME_MAX_PROMPT_CHARS=800
WELCOME_MAX_RESPONSE_TOKENS=1024

# Global token budget (max tokens to request by default). Increase if your LLM/model supports larger completions.
DEFAULT_MAX_TOKENS=4096

# Logging
LOG_LEVEL=INFO

# File Paths / Prompts
PROMPT_PATH_ROLE_CATEGORIZATION_SYSTEM=prompts/role_categorization/system.txt
PROMPT_PATH_USER_VERIFICATION_SYSTEM_TEMPLATE=prompts/user_verification/system_template.txt
PROMPT_PATH_CHANNEL_WELCOME_SYSTEM_TEMPLATE=prompts/welcome_message/system_template.txt
PROMPT_PATH_NEW_USER_SUMMARY_SYSTEM_TEMPLATE=prompts/new_user_summary/system_template.txt
PROMPT_PATH_SUSPICIOUS_ANALYSIS_SYSTEM_TEMPLATE=prompts/suspicious_analysis/system_template.txt
CATEGORIZED_ROLES_FILE=data/categorized_roles.json
# File: .env.example
# Copy this file to .env and fill in your actual values.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.

# Discord Bot Configuration
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# LLM API Configuration
LLM_API_URL=http://localhost:8080/api/chat # Example, adjust to your OpenWebUI chat completions endpoint
LLM_API_TOKEN=YOUR_LLM_API_TOKEN_IF_NEEDED
LLM_MODEL_NAME=your-llm-model-name # e.g., llama3:latest, granite3.1-dense:8b

# Discord Role IDs (replace with actual Role IDs from your server)
VERIFIED_ROLE_ID=
UNVERIFIED_ROLE_ID=
VERIFICATION_IN_PROGRESS_ROLE_ID=
ADMIN_ROLE_IDS= # Comma-separated list of Role IDs, e.g., 123,456

# Discord Channel IDs
NOTIFICATION_CHANNEL_ID= # For admin notifications (e.g., unmappable skills)
WELCOME_CHANNEL_ID= # For LLM-generated welcome messages to new users

# Bot Behavior Configuration
VERIFICATION_RETRIES=3
REBUILD_ROLE_CATEGORIES_ON_STARTUP=false # Set to true to force LLM categorization on next startup

# Logging Configuration
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL

# File Paths
PROMPT_FILE_ROLE_CATEGORIZATION=prompts/role_categorization_prompt.txt
PROMPT_FILE_USER_VERIFICATION=prompts/user_verification_prompt.txt
PROMPT_FILE_CHANNEL_WELCOME=prompts/channel_welcome_prompt.txt
CATEGORIZED_ROLES_FILE=data/categorized_roles.json
PROMPT_FILE_NEW_USER_SUMMARY=prompts/new_user_summary_prompt.txt